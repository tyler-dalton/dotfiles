# ==========================
# GHOSTTY CONFIG - tld 9.29.26
# ==========================
font-family = FiraCode Nerd Font Mono
font-size = 12

theme = Darkside

# Change highlight color format
selection-background = #007a78
selection-foreground = #ffffff

window-padding-x = 14
window-padding-y = 12

background-opacity = 0.90
background-blur-radius = 0

scrollback-limit = 100000000
scroll-to-bottom = keystroke,no-output
scrollbar = never

copy-on-select = clipboard

mouse-hide-while-typing = true
mouse-reporting = true

shell-integration = bash

keybind = ctrl+shift+up=jump_to_prompt:-1
keybind = ctrl+shift_down=jump_to_prompt:1

notify-on-command-finish = unfocused
notify-on-command-finish-action = notify
app-notifications = config-reload
